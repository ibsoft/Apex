{
  "id": "/",
  "name": "APEX",
  "short_name": "APEX",
  "description": "Autonomous agent console: chat, voice, terminals, documents and scheduled tasks.",
  "start_url": "/?launch=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#04080f",
