# APEX - Flask backend (gunicorn)
#
# Templated by deploy/install-services.sh: __ROOT__, __USER__, __GROUP__,
# __GUNBIN__ are replaced with the real paths before installation.
#
# Application configuration (OpenAI OAuth, keys, DEV_MODE, wake word, ...) is
# read from backend/.env at boot (python-dotenv), plus an optional
# /etc/apex/backend.env override. No secrets belong in this file.

[Unit]
Description=APEX assistant - Flask backend (gunicorn)
Documentation=file://__ROOT__/docs/linux-services.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__ROOT__/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/apex/backend.env

# A single worker keeps cross-request, in-memory state coherent. Two workers
# would each keep their own copy of the live PTY terminal sessions
# (terminal window + terminal_command), so a session created by one worker is
# invisible to requests served by the other: the window would open and die, or
# Apex would claim no terminal is open. Chats stay concurrent because each
# thread serves its own SSE stream, and --timeout is large because
# Ollama-on-CPU turns can legitimately take minutes.
ExecStart=__GUNBIN__ --workers 1 --threads 16 --worker-class gthread \
  --timeout 600 --keep-alive 5 --capture-output \
  --access-logfile - --error-logfile - \
  --bind 127.0.0.1:5001 \
  --chdir __ROOT__/backend \
  "app:create_app()"

Restart=on-failure
RestartSec=3

# A single reasonable/nice cap; remove or raise for heavier use.
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target