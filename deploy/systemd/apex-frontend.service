# APEX - Next.js web UI (production build)
#
# Templated by deploy/install-services.sh: __ROOT__, __USER__, __GROUP__,
# __NPM__ are replaced with the real paths before installation.
#
# Requires a production build (npm run build) - install-services.sh does this
# automatically on every install. Rebuild after any frontend change.

[Unit]
Description=APEX assistant - Next.js web UI (production)
Documentation=file://__ROOT__/docs/linux-services.md
After=network-online.target apex-backend.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__ROOT__/frontend
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000

ExecStart=__NPM__ run start -- --hostname 127.0.0.1 --port 3000

Restart=always
RestartSec=3

# On a single-user box 256 open files is plenty; raise for shared hosting.
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target