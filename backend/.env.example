# ---- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=5001
# Secret used to sign session cookies. Set a long random string in production.
SECRET_KEY=
# Public address of this backend (used to build the OAuth redirect URI).
BASE_URL=http://localhost:5001
# Allowed callback/login origin for the web UI.
FRONTEND_URL=http://localhost:3000
# Where data lives: SQLite + ChromaDB + skills overrides.
# DATA_DIR=./
# DB_PATH=./data/apex.db
# CHROMA_DIR=./data/chroma

# ---- Legacy OAuth application integration --------------------------------
# Only for an existing, valid OAuth client registration.
# For ChatGPT subscription login, use the Codex provider below instead.
# Register the redirect URI: <BASE_URL>/api/auth/callback
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
# OPENAI_REDIRECT_URI=http://localhost:5001/api/auth/callback
# Scopes for the consent screen. offline_access yields a refresh token
# so the server can mint fresh access tokens on the user's behalf.
# OPENAI_OAUTH_SCOPE=openid profile email offline_access
# OPENAI_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
# OPENAI_TOKEN_URL=https://auth.openai.com/oauth/token
# OPENAI_JWKS_URL=https://auth.openai.com/.well-known/jwks.json
# OPENAI_ISSUER=https://auth.openai.com

# ---- Platform API ----------------------------------------------------------
# Server-side key used when NOT using the user's OAuth token for calls.
OPENAI_API_KEY=
# OpenAI-compatible base URL (proxy servers, vLLM, etc.).
# OPENAI_BASE_URL=https://api.openai.com/v1
# Use the signed-in user's OAuth access token against the API instead of the
# server key (only works for fine-grained "API on behalf of users" apps).
# USE_OAUTH_ACCESS_KEY=false

# ---- Agent defaults ---------------------------------------------------------
DEFAULT_MODEL=gpt-4o-mini
# Model used when the user signs in with a ChatGPT subscription token.
# CHATGPT_MODEL=gpt-5-codex
# Run the sandboxed run_python tool (NOT enabled by default).
# ENABLE_RUN_PYTHON=false
# MAX_TOOL_STEPS=12

# ---- Local models -----------------------------------------------------------
# Default provider at boot: codex | openai | kimi | ollama | torch   (runtime-changeable).
PROVIDER_DEFAULT=openai
OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b
# TORCH_MODEL=Qwen/Qwen2.5-7B-Instruct
# OLLAMA_EMBED_MODEL=nomic-embed-text
# torch/transformers backend (requires `pip install torch transformers`):
# TORCH_DEVICE=auto        # cuda:0 | mps | auto
# TORCH_MAX_TOKENS=512
# TORCH_SAMPLE=true
# TORCH_TOP_P=0.95
# The UI runtime setting `torch_model` overrides TORCH_MODEL.

# ---- Voice assistant --------------------------------------------------------
WAKE_WORD=apex
RESPONSE_LANGUAGE=en
# Seconds to keep listening for follow-ups after a reply (0 = disabled).
FOLLOW_UP_SECONDS=30
# Preferred browser TTS voice, e.g. "Google UK English Female" (empty = best match).
VOICE='Google UK English Female'

# ---- Agent engine -----------------------------------------------------------
# responses | agents_sdk | langgraph   (all are installed; pick a default).
AGENT_ENGINE=responses

# ---- Memory (vector store) ---------------------------------------------------
MEMORY_ENABLED=true
# auto picks openai -> ollama -> torch -> local hash fallback automatically.
EMBEDDING_BACKEND=auto        # auto|openai|ollama|torch|hash
# EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_RECALL_DEFAULT=5
# MEMORY_SUMMARIZE=true

# ---- Dev mode ----------------------------------------------------------------
# Skip OpenAI OAuth: sign in as a fixed local user so the whole UI works
# against local providers (Ollama / torch) or a server API key.
# DEV_MODE=true
# DEV_AUTO_LOGIN=developer

# ---- Kimi (Moonshot AI - OpenAI-compatible) ----------------------------------
# Get a key at https://platform.moonshot.ai (or console.moonshot.cn).
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2-instruct
# Comma-separated model ids offered in the UI:
# KIMI_MODELS=kimi-k2-instruct,kimi-k2-thinking,kimi-k2-turbo-preview,kimi-k2-0905-preview,kimi-k1.5,moonshot-v1-32k,moonshot-v1-128k

# ---- ChatGPT subscription via Codex -----------------------------------------
# Run python setup_provider.py and choose ChatGPT subscription (Codex).
# No OpenAI client ID or API key is needed for this provider.
# PROVIDER_DEFAULT=codex
# CODEX_BINARY=codex
# CODEX_MODEL=                       # blank uses the Codex account default
# APEX_CODEX_HOME=/absolute/path/to/backend/data/codex
# DEV_AUTO_LOGIN=developer           # trusted local use; bypasses web UI sign-in
# Credentials stay in the Codex home directory, not this file.
