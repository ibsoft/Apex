# ---- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=5001
# Secret used to sign session cookies. Set a long random string in production.
SECRET_KEY=
# Public backend URL used for ALL hosted download/image links and OAuth callbacks.
# Set to your browser-reachable hostname or LAN IP, including the backend port.
# Do not add /api; a reverse-proxy path prefix is allowed.
BASE_URL=http://localhost:5001
# Allowed callback/login origin for the web UI.
FRONTEND_URL=http://localhost:3000
# Where data lives: SQLite + ChromaDB + skills overrides.
# DATA_DIR=./
# DB_PATH=./data/apex.db
# CHROMA_DIR=./data/chroma

# ---- Legacy OAuth application integration --------------------------------
# Only for an existing, valid OAuth client registration.
# For ChatGPT subscription login, use the Codex provider below instead.
# Register the redirect URI: <BASE_URL>/api/auth/callback
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
# OPENAI_REDIRECT_URI=http://localhost:5001/api/auth/callback
# Scopes for the consent screen. offline_access yields a refresh token
# so the server can mint fresh access tokens on the user's behalf.
# OPENAI_OAUTH_SCOPE=openid profile email offline_access
# OPENAI_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
# OPENAI_TOKEN_URL=https://auth.openai.com/token
# OPENAI_JWKS_URL=https://auth.openai.com/.well-known/jwks.json
# OPENAI_ISSUER=https://auth.openai.com

# ---- Platform API ----------------------------------------------------------
# Server-side key used when NOT using the user's OAuth token for calls.
OPENAI_API_KEY=
# OpenAI-compatible base URL (proxy servers, vLLM, etc.).
# OPENAI_BASE_URL=https://api.openai.com/v1
# Use the signed-in user's OAuth access token against the API instead of the
# server key (only works for fine-grained "API on behalf of users" apps).
# USE_OAUTH_ACCESS_KEY=false

# ---- Agent defaults ---------------------------------------------------------
DEFAULT_MODEL=gpt-4o-mini
# Model used when the user signs in with a ChatGPT subscription token.
# CHATGPT_MODEL=gpt-5-codex
# Model used by the "code" skill when no runtime/user model is selected.
# Defaults to CHATGPT_MODEL.
# CODE_MODEL=gpt-5-codex
# Think-hard model. When THINK_HARD_MODEL_ENABLED is true, a single turn the
# user asked APEX to "think hard" on runs on this model instead of the main
# one (trigger: "think hard: <request>" in text or voice, or the Think hard
# switch in Settings). Leave the model empty to disable the switch.
# THINK_HARD_MODEL=gpt-5
# THINK_HARD_MODEL_ENABLED=false
# Run the sandboxed run_python tool (NOT enabled by default).
# ENABLE_RUN_PYTHON=false
# Run local shell commands without sandboxing (NOT enabled by default).
# ENABLE_RUN_SHELL=false
# RUN_SHELL_TIMEOUT=60
# How long run_shell on_screen=true outputs stay viewable/downloadable.
# SHELL_OUT_TTL_SECONDS=3600
# Host-wide PTY terminals ("open terminal" window) reuse ENABLE_RUN_SHELL: a
# terminal is a shell on the host, so it is only available when run_shell is on.
# Sessions that are not polled for this many seconds are killed (closed tab).
# TERMINAL_IDLE_SECONDS=300
# MAX_TOOL_STEPS=12

# ---- Scheduled tasks -----------------------------------------------------
# Cron-backed jobs APEX creates and then runs on its own, reporting the result
# back to the Tasks tab and to chat. Setting TASKS_ENABLED=false removes the
# tools, the routes and the runner thread entirely.
# TASKS_ENABLED=true
# How often the runner asks the database which tasks are due.
# TASKS_TICK_SECONDS=20
# Task turns allowed to run at the same time process-wide. Keep this at 1: each
# run is a full agent turn with tools.
# TASKS_MAX_CONCURRENT=1
# Hard ceiling on one task turn, in seconds.
# TASKS_TIMEOUT_SECONDS=600
# Turns of the task's own conversation replayed as context for the next run.
# TASKS_HISTORY_WINDOW=20
# TASKS_MAX_PER_USER=50
# Run a task once on startup if its moment passed while the backend was down.
# TASKS_CATCH_UP=true
# When the active skill is "general", ask the model to auto-select the best
# specialist skill for each user message and route the turn through it.
# AUTO_ROUTE_FROM_GENERAL=true

# ---- Web search -------------------------------------------------------------
# These are configurable so the search tool does not rely on hardcoded values.
# WEB_SEARCH_ENGINE=duckduckgo
# WEB_SEARCH_DDG_URL=https://html.duckduckgo.com/html/
# WEB_SEARCH_DDG_REGION=us-en
# WEB_SEARCH_TIMEOUT=20
# WEB_SEARCH_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) APEX-assistant/1.0

# ---- Local models -----------------------------------------------------------
# Default provider at boot: codex | openai | kimi | ollama | torch   (runtime-changeable).
PROVIDER_DEFAULT=openai
OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b
# TORCH_MODEL=Qwen/Qwen2.5-7B-Instruct
# OLLAMA_EMBED_MODEL=nomic-embed-text
# torch/transformers backend (requires `pip install torch transformers`):
# TORCH_DEVICE=auto        # cuda:0 | mps | auto
# TORCH_MAX_TOKENS=512
# TORCH_SAMPLE=true
# TORCH_TOP_P=0.95
# The UI runtime setting `torch_model` overrides TORCH_MODEL.

# ---- Voice assistant --------------------------------------------------------
WAKE_WORD=apex
RESPONSE_LANGUAGE=en
# Seconds to keep listening for follow-ups after a reply (0 = disabled).
FOLLOW_UP_SECONDS=30
# Preferred browser TTS voice, e.g. "Google UK English Female" (empty = best match).
VOICE='Google UK English Female'

# ---- Agent engine -----------------------------------------------------------
# responses | agents_sdk | langgraph   (all are installed; pick a default).
AGENT_ENGINE=responses

# ---- Memory (vector store) ---------------------------------------------------
MEMORY_ENABLED=true
# auto picks openai -> ollama -> torch -> local hash fallback automatically.
EMBEDDING_BACKEND=auto        # auto|openai|ollama|torch|hash
# EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_RECALL_DEFAULT=5
# MEMORY_SUMMARIZE=true
# Summarize a conversation into long-term memory when you leave it (new thread
# or switching conversations), so Apex can recall it when asked later.
# MEMORY_CONVERSATION_SUMMARIZE=true
# MEMORY_CONVERSATION_MIN_MESSAGES=4
# MEMORY_CONVERSATION_SUMMARIZE_WINDOW=60

# ---- Obsidian (local Markdown vault) -----------------------------------------
# Absolute path to the folder containing your Obsidian .md notes.
# OBSIDIAN_VAULT_PATH=/home/user/Obsidian
# Optional daily-notes folder inside the vault (empty = vault root).
# OBSIDIAN_DAILY_NOTES_FOLDER=Daily
# strftime format for the daily note filename.
# OBSIDIAN_DAILY_NOTES_FORMAT=%Y-%m-%d

# ---- Dev mode ----------------------------------------------------------------
# Skip OpenAI OAuth: sign in as a fixed local user so the whole UI works
# against local providers (Ollama / torch) or a server API key.
# DEV_MODE=true
# DEV_AUTO_LOGIN=developer

# ---- Kimi (Moonshot AI - OpenAI-compatible) ----------------------------------
# Get a key at https://platform.moonshot.ai (or console.moonshot.cn).
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2-instruct
# Comma-separated model ids offered in the UI:
# KIMI_MODELS=kimi-k2-instruct,kimi-k2-thinking,kimi-k2-turbo-preview,kimi-k2-0905-preview,kimi-k1.5,moonshot-v1-32k,moonshot-v1-128k

# ---- ChatGPT subscription via Codex -----------------------------------------
# Run python setup_provider.py and choose ChatGPT subscription (Codex).
# No OpenAI client ID or API key is needed for this provider.
# PROVIDER_DEFAULT=codex
# CODEX_BINARY=codex
# CODEX_MODEL=                       # blank uses the Codex account default
# APEX_CODEX_HOME=/absolute/path/to/backend/data/codex
# DEV_AUTO_LOGIN=developer           # trusted local use; bypasses web UI sign-in
# Credentials stay in the Codex home directory, not this file.

# ---- File manager (Explorer window) ----------------------------------------
# The File Manager browses the same roots as the FILE_SEARCH skill. Defaults to
# the system root; optionally restrict to colon-separated directories. Paths
# outside these roots (and the virtual /proc /sys /dev /run trees) are always
# refused. Requires a backend restart after changing.
# FILE_SEARCH_ROOTS=/home/your-user/Documents:/home/your-user/Downloads
# Download links for zips / single files expire after this many seconds.
# FM_FILE_TTL_SECONDS=3600
# Finished copy/move jobs are dropped from memory after this many seconds.
# FM_JOB_TTL_SECONDS=3600
# Maximum number of files allowed per upload / copy / trash request.
# FM_UPLOAD_MAX_FILES=1000

# ---- Notepad ---------------------------------------------------------------
# Blank saves standalone HTML under ~/Documents/APEX Notepad/<signed-in-user>/.
# NOTEPAD_DOCUMENTS_DIR=/home/your-user/Documents/APEX Notepad

# ---- EDITOR skill -----------------------------------------------------------
# Generates formatted Word (.docx) and Excel (.xlsx) documents with tables,
# charts, images and styles. Files are stored temporarily on the server.
# EDITOR_ENABLED=true
# EDITOR_FILE_TTL_SECONDS=3600

# ---- VISIO skill (camera + vision model) ------------------------------------
# On-demand Linux host camera snapshots; requires ffmpeg and device permissions.
# Settings can override these defaults. Select an image-capable model explicitly.
# OpenAI requires OPENAI_API_KEY; Ollama uses OLLAMA_BASE_URL.
# VISIO_ENABLED=false
# VISIO_PROVIDER=ollama
# VISIO_MODEL=
# Empty selects the first accessible /dev/videoN node.
# VISIO_CAMERA=
# Frames are saved to Pictures only when explicitly requested. Face recognition and biometric memory are unsupported.

# ---- SIP skill (outbound phone calls) ----------------------------------------
# OFF unless explicitly enabled. The settings tab edits all of these and writes
# them back into THIS file (SIP_ENV_FILE), so you only need to hand-edit them for
# a headless deployment. Calls are placed with baresip; speech out uses local
# eSpeak by default or optional online Edge TTS, and speech back is faster-whisper
# in its own virtualenv.
# speech back is faster-whisper in its own virtualenv.
# Required once enabled:
# SIP_SERVER=pbx.example.org
# SIP_USER=1001
# SIP_PASSWORD=
# Optional:
# udp | tcp | tls. Anything else is refused on save.
# SIP_TRANSPORT=udp
# Empty means the server's default port.
# SIP_PORT=
# SIP_DISPLAY_NAME=APEX
# Empty falls back to SIP_SERVER.
# SIP_DOMAIN=
# Optional destination for scheduled "call me" notifications.
# SIP_NOTIFY_TO=+15551234567
# Empty means direct, no outbound proxy.
# SIP_OUTBOUND_PROXY=
# Local eSpeak is the default. `edge` uses Microsoft's online Edge TTS service;
# spoken text is sent to that service. SIP_TTS_VOICE accepts an Edge voice name
# (for example en-US-AriaNeural) and is ignored by local eSpeak.
# SIP_TTS_ENGINE=espeak
# SIP_TTS_VOICE=
# Ceiling on a single call, in seconds.
# SIP_MAX_DURATION_SECONDS=600
# How long a `listen` turn waits for the person to start talking.
# SIP_LISTEN_TIMEOUT_SECONDS=20
# faster-whisper interpreter, kept out of the backend's own dependencies. Create
# it once with the pinned requirements (the pins matter, see the file):
#   python3 -m venv .venv/sip-whisper
#   .venv/sip-whisper/bin/pip install -r backend/tools/sip-whisper-requirements.txt
# SIP_WHISPER_PYTHON=/home/your-user/Development/Apex/.venv/sip-whisper/bin/python
# SIP_WHISPER_MODEL=tiny
# Bare SIP has no encryption of its own. Use SIP_TRANSPORT=tls, or SIP_SERVER=sips:
# ... , if the account carries anything worth protecting.

# ---- Image browser (optional local gallery) ---------------------------------
# Absolute path to a local directory of images APEX can browse by voice.
# Internet image search works regardless of this setting.
# IMAGES_DIR=/home/your-user/Pictures

# ---- VAPT skill (authorized vulnerability assessment) ------------------------
# Runs the VAPT command runner on this host. OFF unless explicitly enabled.
VAPT_ENABLED=true
# Root folder where each target becomes a project:
#   $VAPT_PROJECTS/<target>/{artifacts,scripts,reports}
VAPT_PROJECTS=/home/ioannisb/VAPT
# Max parallel commands inside a scripted batch.
# VAPT_MAX_PARALLEL=3
# Per-command timeout (seconds).
# VAPT_CMD_TIMEOUT=300
# Report download links expire after this many seconds.
# VAPT_REPORT_TTL_SECONDS=3600
# Unsaved sudo password single-use window (seconds).
# VAPT_SUDO_SINGLE_USE_SECONDS=120
# "Save for this session" sudo password lifetime (minutes). 0 = until logout/restart.
# VAPT_SUDO_TTL_MINUTES=0
# Sudo passwords are held ONLY in server memory, never on disk.

# ---- CODE skill (developer projects / git / GitHub) --------------------------
# Root folder where each coding project lives as its own git repository:
#   $CODE_PROJECTS/<project>
CODE_PROJECTS=/home/ioannisb/Development/Projects
# Default git branch created by code_start / pushed by code_push.
# CODE_BRANCH=main
# GitHub authentication: the first `code_push` shows a popup asking for a
# Personal Access Token (scope: repo). It is validated against the GitHub API
# and stored per-user, chmod 600, under .apex/github_tokens/ (gitignored).
# CODE_GITHUB_DIR=/home/ioannisb/Development/Apex/.apex/github_tokens

# ---- File manager (Explorer window) ----------------------------------------
# FILE_SEARCH_ROOTS=/home/your-user/Documents:/home/your-user/Downloads
# FM_FILE_TTL_SECONDS=3600        # zip / single-file download link lifetime
# FM_JOB_TTL_SECONDS=3600        # finished copy/move jobs kept in memory
# FM_UPLOAD_MAX_FILES=1000       # max files per upload / copy / trash
# ---- Sign-in, lock screen and session security ------------------------------
# APEX authenticates against the machine's own accounts: the user list comes
# from /etc/passwd and the password is checked by PAM. No password is ever
# stored, logged or sent to a provider.
# SYSTEM_LOGIN_ENABLED=true
# PAM service used for the check. "login" is present on every distribution.
# SYSTEM_LOGIN_PAM_SERVICE=login
# Show the account list on the sign-in screen. Turn off to show a plain field
# (the list does disclose account names to anyone who can reach the page).
# SYSTEM_LOGIN_SHOW_USERS=true
# Restrict sign-in to accounts whose *primary* group is one of these. Empty = any
# login-capable account. Uses numeric gids from the live system.
# SYSTEM_LOGIN_GROUPS=users,admin
# Throttle: wrong passwords are counted per username AND source address, so one
# host cannot lock a colleague out of their own account.
# SYSTEM_LOGIN_MAX_ATTEMPTS=5
# SYSTEM_LOGIN_WINDOW_SECONDS=300     # counting window
# SYSTEM_LOGIN_LOCKOUT_SECONDS=300   # how long a locked-out name is refused
# SYSTEM_LOGIN_AUDIT_LOG=/path/auth-audit.log   # user, address, result; never passwords
# Let an OpenAI OAuth account sign in *as well as* a system account. Off by
# default: while system login is on, OAuth is a way around the machine's own
# account list, so it is only offered when you deliberately ask for it.
# SYSTEM_LOGIN_ALLOW_OAUTH=false

# Lock screen. Re-checks the password through PAM; the API answers 423 for the
# whole session while locked, so a stale tab or curl cannot keep using APEX.
# LOCK_SCREEN_ENABLED=true
# LOCK_IDLE_SECONDS=0        # 0 = lock only on the "lock" voice/text command

# Cross-site request forgery. Every state-changing request must carry a token
# that only same-origin code can read. Turn off only for a throwaway test run.
# CSRF_ENABLED=true

# Cookies and origins. SESSION_COOKIE_SECURE should be true whenever the app is
# reached over HTTPS.
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_NAME=apex_session
# SESSION_LIFETIME_HOURS=168
# Only set TRUST_PROXY behind a reverse proxy you control: it is what makes
# X-Forwarded-For count for the login throttle.
# TRUST_PROXY=false
# Comma-separated extra browser origins allowed to call the API with
# credentials. Anything not listed gets no CORS headers at all.
# EXTRA_ALLOWED_ORIGINS=

# Dev auto-login is ignored while SYSTEM_LOGIN_ENABLED is on. With it left on,
# every empty session is silently re-authenticated as that user: the sign-in
# screen is skipped, "sign out" cannot log anyone out, and the lock screen asks
# PAM about the dev account instead of the person at the keyboard. Turn system
# login off (or set this to true) to use DEV_AUTO_LOGIN deliberately.
# DEV_AUTO_LOGIN_WITH_SYSTEM_LOGIN=false
