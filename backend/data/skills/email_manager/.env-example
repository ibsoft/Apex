# email_manager pack config - read only by mail.py, never pasted into chat.
# Edit this file directly to change values or add secrets.
POP3_SERVER=
POP3_EMAIL=
SMTP_SERVER=
POP3_PORT=110
SMTP_PORT=25
POP3_PASSWORD=
# SMTP_FROM=              <- optional, defaults to POP3_EMAIL
# SMTP_HELO_HOST=         <- optional HELO/EHLO name
# SMTP_USERNAME=          <- optional SMTP AUTH (needs SMTP_PASSWORD too)
# SMTP_PASSWORD=
POP3_SSL=false
SMTP_SSL=false
SMTP_TLS_VERIFY=false
